# ============================================================
# ADSMS Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (it's already in .gitignore).
# ============================================================

PORT=5001

# MongoDB Atlas Connection String
# ─────────────────────────────────────────────────────────────
# 1. Login → https://cloud.mongodb.com
# 2. Cluster → Connect → Drivers → copy the URI
# 3. Replace <username> and <password> with your Atlas user credentials
# 4. Add /adms before the ? for the database name
#
# Atlas Checklist BEFORE connecting:
#   ✔ Database Access → user exists with password set
#   ✔ Database Access → role: "Atlas Admin" or "Read and write to any database"
#   ✔ Network Access  → IP 0.0.0.0/0 added (Allow from anywhere)
#   ✔ Cluster is not paused (free tier pauses after 60 days of inactivity)
# ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adms?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRE=7d

# Gmail SMTP (optional — for email notifications)
# Setup: Google Account → Security → 2-Step Verification → App Passwords → Mail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
